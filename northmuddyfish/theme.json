{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "color": {
            "custom": true,
            "defaultPalette": true,
			"duotone": [],
            "defaultDuotone": false,
            "customDuotone": false,
            "gradients": [],
            "defaultGradients": false,
            "customGradient": false,
            "background": true,
            "text": true,
            "link": false,
            "palette": [
                {
                    "name": "Blue",
                    "slug": "blue",
                    "color": "#0000ff"
                }
            ]
        },
		"layout": {
            "contentSize": "1400px",
            "wideSize": "1700px"
        },
        "spacing": {
            "blockGap": true,
            "margin": true,
            "padding": true,
            "units": [ "px", "em", "rem", "vh", "vw", "%" ],
            "spacingScale": {
                "operator": "*",
                "increment": 0.5,
                "mediumStep": 3,
                "steps": 7,
                "unit": "em"
            }
        },
        "typography": {
            "customFontSize": true,
            "lineHeight": true,
            "dropCap": false,
            "fluid": false,
            "fontStyle": true,
            "fontWeight": true,
            "letterSpacing": true,
            "textDecoration": true,
            "textTransform": true,
            "fontFamilies": [
                {
                    "fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif",
                    "name": "Display Font",
                    "slug": "system-font"
                }
            ]
        },
        "position": {
            "sticky": false
        },
        "dimensions": {
            "minHeight": true
        },
        "shadow": {
            "defaultPresets": false,
            "presets": []
        }
    },
    "styles": {
        "color": {
            "background":"#BFBFBF"
        },
        "typography": {
            "fontFamily": "'Lato', 'Arial', sans-serif"
        },
        "blocks": {
            "core/button": {
                "border": {
                    "radius": "10px"
                },
                "color": {
                    "text": "white"
                },
                "typography": {
                    "fontWeight": "bold",
                    "fontSize": "17px"
                },
                "spacing": {
                    "padding": {
                        "top": ".75em",
                        "right": "1.375em",
                        "bottom": ".75em",
                        "left": "1.375em"
                    }
                }
            }
        }
    }
}
